# Anthropic API key used for scans and fixes
ANTHROPIC_API_KEY=
# Port for the API server
PORT=8787
# Public base URL of this server (Stripe sends people back to it after checkout)
PUBLIC_URL=http://localhost:8787
# Comma-separated list of allowed Chrome extension origins, e.g. chrome-extension://abcdef...
# Leave empty during local development to allow any chrome-extension:// origin.
ALLOWED_ORIGINS=
# Max characters of source code sent to the AI per scan (~4 chars per token)
MAX_SCAN_CHARS=400000
# SQLite file for accounts, usage and scan history. Put it on a persistent disk in production.
DATABASE_PATH=data/launch-check.db

# --- Stripe billing (all three are needed to enable upgrades) ---
# Dashboard > Developers > API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=
# ID of the recurring price for the Pro plan (price_...)
STRIPE_PRICE_ID=

# --- Plan limits (defaults shown) ---
# Free: lifetime allowance
FREE_SCANS=1
FREE_FIXES=2
# Pro: allowance per billing period
PRO_SCANS_PER_PERIOD=10
PRO_FIXES_PER_PERIOD=100
