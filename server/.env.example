# Anthropic API key used for scans and fixes
ANTHROPIC_API_KEY=
# Model used for scans and fixes (claude-sonnet-5-5 is half the price of claude-opus-5-5)
AI_MODEL=claude-sonnet-5-5
# Thinking effort: low, medium, high, xhigh or max. medium is cheaper; high reviews more deeply.
AI_EFFORT=medium
# Port for the API server
PORT=8787
# Public base URL of this server (Stripe sends people back to it after checkout)
PUBLIC_URL=http://localhost:8787
# Comma-separated list of allowed Chrome extension origins, e.g. chrome-extension://abcdef...
# Leave empty during local development to allow any chrome-extension:// origin.
ALLOWED_ORIGINS=
# Max characters of source code sent to the AI per scan (~4 chars per token)
MAX_SCAN_CHARS=250000
# SQLite file for accounts, usage and scan history. Put it on a persistent disk in production.
DATABASE_PATH=data/launch-check.db

# --- Stripe billing (all three are needed to enable upgrades) ---
# Dashboard > Developers > API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=
# ID of the recurring price for the Pro plan (price_...)
STRIPE_PRICE_ID=

# --- Plan limits (defaults shown) ---
# Free: lifetime allowance
# (free scans are built-in checks only and cost nothing; the AI review is Pro-only)
FREE_SCANS=3
FREE_FIXES=2
# Pro: allowance per billing period
PRO_SCANS_PER_PERIOD=10
PRO_FIXES_PER_PERIOD=25
# Set to 1 to give free accounts the AI review too (local development only)
FREE_AI_REVIEW=0

# --- Credit packs (one-time purchases; optional) ---
# Comma-separated "stripe_price_id:credits". Create each as a ONE-TIME Price in Stripe.
# Example: CREDIT_PACKS=price_abc:25,price_def:60,price_ghi:150
CREDIT_PACKS=
# What one AI scan and one fix cost in credits
CREDITS_PER_SCAN=5
CREDITS_PER_FIX=2
